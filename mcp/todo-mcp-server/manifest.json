{
  "name": "todo-mcp-server",
  "display_name": "Todo MCP Server",
  "version": "1.0.0",
  "type": "mcp",
  "description": "Manage a persistent todo list through MCP tools.",
  "author": "Aaron Dalibard",
  "license": "MIT",
  "tags": [
    "mcp",
    "todo",
    "task-management"
  ],
  "runtime": {
    "type": "python",
    "version": ">=3.10"
  },
  "entrypoint": "main.py",
  "permissions": {
    "network": false,
    "filesystem": true,
    "shell": false,
    "environment": true
  },
  "dependencies": [
    "mcp"
  ],
  "mcp": {
    "transport": "stdio",
    "tools": [
      "add_todo",
      "list_todos",
      "complete_todo",
      "delete_todo"
    ]
  }
}
