{
  "name": "text-utils-mcp-server",
  "display_name": "Text Utils MCP Server",
  "version": "1.0.0",
  "type": "mcp",
  "description": "Text transformation and statistics utilities as MCP tools.",
  "author": "Aaron Dalibard",
  "license": "MIT",
  "tags": [
    "mcp",
    "text",
    "utilities"
  ],
  "runtime": {
    "type": "python",
    "version": ">=3.10"
  },
  "entrypoint": "main.py",
  "permissions": {
    "network": false,
    "filesystem": true,
    "shell": false,
    "environment": true
  },
  "dependencies": [
    "mcp"
  ],
  "mcp": {
    "transport": "stdio",
    "tools": [
      "count_stats",
      "extract_keywords",
      "convert_case"
    ]
  }
}
