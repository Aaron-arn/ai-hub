{
  "name": "sqlite-mcp",
  "display_name": "SQLite MCP Server",
  "version": "1.0.0",
  "type": "mcp",
  "description": "Query and manage SQLite databases through the Model Context Protocol. Exposes query and list_tables tools over stdio.",
  "author": "Aaron Dalibard",
  "license": "MIT",
  "tags": ["database", "mcp"],
  "runtime": {
    "type": "python",
    "version": ">=3.10"
  },
  "entrypoint": "main.py",
  "permissions": {
    "network": false,
    "filesystem": true,
    "shell": false,
    "environment": false
  },
  "dependencies": ["mcp"],
  "mcp": {
    "transport": "stdio",
    "tools": ["query", "list_tables"]
  }
}
